# ====================================================================
# 小水华会议助手 MVP V0.1 —— 后端本地配置模板
# ====================================================================
# 用法：
#     cp backend/.env.example backend/.env
# 然后按需修改本机 .env。
#
# ⚠️ backend/.env 是本机配置，已被 .gitignore 忽略（第 21 行 `.env`）。
#    **永远不要提交**任何真实 API Key / token / credential / 内部地址。
# ====================================================================

# --- Provider 选择 ---------------------------------------------------
# fake     = 离线确定性 FakeProvider（默认，推荐给无 Key 的协作者 / CI）
# deepseek = 真实 DeepSeek Provider（需要下面的凭据）
# 拼错的值会 fail-closed 抛 LLMConfigurationError，不会静默回落 fake。
LLM_PROVIDER=fake

# --- Agent 开关 ------------------------------------------------------
MEETING_AGENT_ENABLED=true
FINAL_SUMMARY_V2_ENABLED=true

# --- 水华队长：两阶段裁判（Quick + Deep）-----------------------------
# false = 单通道（一次 LLM 调用，产出一份扁平报告）。这是既有行为，
#         仍是默认值：整套离线测试、场景 fixture 与 Phase 3-2E 搜索 A/B
#         基线都按这个契约写的，改默认值会静默改变它们的语义。
# true  = 两阶段：先 Quick（1-2 秒目标，只输出「核心争议 / 关键证据 /
#         临时判断 / 最值得确认的问题」），立刻经 SSE
#         `captain.quick_assessment` 推给前端；再跑 Deep（完整推理）。
#         产品化时应置 true —— 否则前端收不到 Quick 事件，两阶段的收益
#         （第一个答案更早出现）为零。
CAPTAIN_TWO_STAGE_ENABLED=false

# --- 水华队长：外部资料检索（Phase C.5）------------------------------
# master 开关。关闭时不做任何 policy 判定 / provider 构造 / 缓存查询，
# 报告行为与 Phase 3-2 之前完全一致。检索始终是「增强」，不是前置条件：
# 开着但 provider 坏了，报告依然完成（只是没有外部证据）。
CAPTAIN_EXTERNAL_SEARCH_ENABLED=true
# 供应方选择（Phase 3-2E 的 A/B 开关）。未知值 fail-closed 抛错，不会
# 静默回落到某个默认值 —— 拼错会让 A/B 变成「自己跟自己比」。
CAPTAIN_SEARCH_PROVIDER=fake

# 单次检索调用的硬超时（毫秒）。超时即丢弃结果，不等它返回：晚到的答案
# 只花时间、不产出内容。**这个值只约束检索调用本身**，不影响
# LLM_TIMEOUT_SECONDS / CAPTAIN_QUICK_TIMEOUT_SECONDS。
#
# Phase C.5 由 900 调到 2500，原因有两条，缺一不可：
#   1. 研究现在发生在 Quick 已经发出之后（`_generate_two_stage` 在
#      on_quick 边界之后才调用 enrichment），所以更长的检索不会碰到
#      Quick 的 1-2 秒目标。在旧的顺序下这个值直接压在 Quick 的关键路径上，
#      调大等于让那个目标注定达不到。
#   2. 900ms 当初是猜的，不是量出来的，而且短于本机到真实搜索 API 的一次
#      往返。实测约 2s 才是「能拿到结果」的下限；低于下限的超时预算等于
#      每次必然过期，整层检索变成永远报 timeout 的死代码。
# 仍可由本文件覆盖，仅作为 Phase 3-2E 调参的起点。
CAPTAIN_SEARCH_TIMEOUT_MS=2500
# provider 自身的返回上限，保持 <= 5。
CAPTAIN_SEARCH_MAX_RESULTS=5
# 允许进入 prompt 的来源数。与 max_results 刻意分开：provider 可以返回
# 5 条，我们仍然只为 3 条买 token 预算。这是 TOKEN 预算，也是 Phase 3-2E
# 用来衡量相关性的那个变量。
CAPTAIN_SEARCH_MAX_SOURCES_FOR_LLM=3

# 会中理解是近实时链路：满足片段数、时间或停顿条件时合并刷新一次。
MEETING_AGENT_REALTIME_MIN_SEGMENTS=8
MEETING_AGENT_REALTIME_TARGET_INTERVAL_SECONDS=25
MEETING_AGENT_REALTIME_SILENCE_SECONDS=10
MEETING_AGENT_REALTIME_MAX_WAIT_SECONDS=45
MEETING_AGENT_LLM_TIMEOUT_SECONDS=25
MEETING_AGENT_MAX_ATTEMPTS=1
MEETING_AGENT_PARSE_REPAIR=false

# --- 真实 Provider（仅 LLM_PROVIDER=deepseek 时需要）-----------------
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash

# --- 模型生成稳定性 ---------------------------------------------------
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096

# --- 可选：Final Summary 单独指定模型 --------------------------------
# 留空 = 用 provider 自身默认模型（即 LLM-CONFIG-1 之前的行为）
FINAL_SUMMARY_MODEL=
FINAL_SUMMARY_LLM_TIMEOUT_SECONDS=120
# State 已完整覆盖时附带的结尾原文段数；用于捕获最后修正和收尾结论。
FINAL_SUMMARY_TAIL_SEGMENTS=6
# State 落后不超过该段数时直接合并全部尾部；超过则使用完整转写兜底。
FINAL_SUMMARY_MAX_UNPROCESSED_TAIL_SEGMENTS=12

# --- 可选：数据库 ----------------------------------------------------
# 默认 sqlite:///./data/xiaoshuihua.db
# DATABASE_URL=sqlite:///./data/xiaoshuihua.db

# Snowflake 节点编号（0-1023）。多实例共用数据库时，每个实例必须不同。
MEETING_ID_WORKER_ID=0

# --- 腾讯云实时语音识别 ---------------------------------------------
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh_en_2.0
TENCENT_ASR_DEBUG=0
ASR_SPEAKER_LABELS_ENABLED=false

# 仅应用于发送给 ASR 的 PCM 副本；原始录音保持不变。
ASR_AUDIO_GAIN=1.0

# 点击结束会议后，等待音频、ASR 尾句和转写队列排空的最长时间（秒）。
AUDIO_SESSION_STOP_TIMEOUT_SECONDS=40

# 当前会议室使用的音频设备；业务代码不直接写死设备编号。
SHUIHUA_AUDIO_DEVICE_ID=ESP32-001
