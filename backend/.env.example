# ====================================================================
# 小水华会议助手 MVP V0.1 —— 后端本地配置模板
# ====================================================================
# 用法：
#     cp backend/.env.example backend/.env
# 然后按需修改本机 .env。
#
# ⚠️ backend/.env 是本机配置，已被 .gitignore 忽略（第 21 行 `.env`）。
#    **永远不要提交**任何真实 API Key / token / credential / 内部地址。
# ====================================================================

# --- Provider 选择 ---------------------------------------------------
# fake     = 离线确定性 FakeProvider（默认，推荐给无 Key 的协作者 / CI）
# deepseek = 真实 DeepSeek Provider（需要下面的凭据）
# 拼错的值会 fail-closed 抛 LLMConfigurationError，不会静默回落 fake。
LLM_PROVIDER=fake

# --- Agent 开关 ------------------------------------------------------
MEETING_AGENT_ENABLED=true
FINAL_SUMMARY_V2_ENABLED=true

# 会中理解是近实时链路：满足片段数、时间或停顿条件时合并刷新一次。
MEETING_AGENT_REALTIME_MIN_SEGMENTS=8
MEETING_AGENT_REALTIME_TARGET_INTERVAL_SECONDS=25
MEETING_AGENT_REALTIME_SILENCE_SECONDS=10
MEETING_AGENT_REALTIME_MAX_WAIT_SECONDS=45
MEETING_AGENT_LLM_TIMEOUT_SECONDS=25
MEETING_AGENT_MAX_ATTEMPTS=1
MEETING_AGENT_PARSE_REPAIR=false

# --- 真实 Provider（仅 LLM_PROVIDER=deepseek 时需要）-----------------
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash

# --- 模型生成稳定性 ---------------------------------------------------
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096

# --- 可选：Final Summary 单独指定模型 --------------------------------
# 留空 = 用 provider 自身默认模型（即 LLM-CONFIG-1 之前的行为）
FINAL_SUMMARY_MODEL=
FINAL_SUMMARY_LLM_TIMEOUT_SECONDS=120

# --- 可选：数据库 ----------------------------------------------------
# 默认 sqlite:///./data/xiaoshuihua.db
# DATABASE_URL=sqlite:///./data/xiaoshuihua.db

# --- 腾讯云实时语音识别 ---------------------------------------------
TENCENT_ASR_APP_ID=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh_en_speaker_2.0
TENCENT_ASR_DEBUG=0

# 仅应用于发送给 ASR 的 PCM 副本；原始录音保持不变。
ASR_AUDIO_GAIN=1.0

# 点击结束会议后，等待音频、ASR 尾句和转写队列排空的最长时间（秒）。
AUDIO_SESSION_STOP_TIMEOUT_SECONDS=40

# 当前会议室使用的音频设备；业务代码不直接写死设备编号。
SHUIHUA_AUDIO_DEVICE_ID=ESP32-001
